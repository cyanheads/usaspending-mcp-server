{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "usaspending-mcp-server",
  "version": "0.4.4",
  "description": "Access US federal award, recipient, agency, and spending analytics data from USAspending.gov via MCP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/usaspending-mcp-server#readme",
  "repository": "https://github.com/cyanheads/usaspending-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "federal-spending",
    "usaspending",
    "government-contracts"
  ],
  "mcpServers": {
    "usaspending-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/usaspending-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
